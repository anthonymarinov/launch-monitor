{
  "version": 3,
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "generator": "Unix Makefiles",
      "cacheVariables": {
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
      }
    },
    {
      "name": "cpu-debug",
      "displayName": "CPU Debug",
      "inherits": "base",
      "binaryDir": "${sourceDir}/build/cpu-debug",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "LAUNCH_MONITOR_ENABLE_CUDA": "OFF"
      }
    },
    {
      "name": "cuda-debug",
      "displayName": "CUDA Debug",
      "inherits": "base",
      "binaryDir": "${sourceDir}/build/cuda-debug",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "LAUNCH_MONITOR_ENABLE_CUDA": "ON"
      }
    },
    {
      "name": "cuda-release",
      "displayName": "CUDA Release",
      "inherits": "base",
      "binaryDir": "${sourceDir}/build/cuda-release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "LAUNCH_MONITOR_ENABLE_CUDA": "ON"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "cpu-debug",
      "configurePreset": "cpu-debug"
    },
    {
      "name": "cuda-debug",
      "configurePreset": "cuda-debug"
    },
    {
      "name": "cuda-release",
      "configurePreset": "cuda-release"
    }
  ]
}
